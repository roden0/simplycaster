# Copy to .env next to docker-compose.yml and fill it in. Never commit .env.

# Domain of this instance; its DNS must point to this server (ports 80 and 443 open).
DOMAIN=studio.example.com

# Secret of the backoffice link https://<DOMAIN>/backoffice/<BACKOFFICE_TOKEN>.
# Generate it with: openssl rand -hex 16
BACKOFFICE_TOKEN=

# Public IPv4 of this server, for the live conversation through TURN (not the domain).
# Empty: only direct connections, enough on a local network. Open the UDP ports in the firewall.
TURN_PUBLIC_IP=
# TURN_PORT=3478
# TURN_RELAY_PORTS=49160-49199

# --- Backups (restic) ---
# Encrypts the backups. Keep a copy somewhere else: without it they cannot be restored.
# Generate it with: openssl rand -hex 24
RESTIC_PASSWORD=

# Where backups go. Default /backups is the ./backups folder on this same server, which does not
# survive losing the server. Any restic repository works, for example:
#   RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/simplycaster
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   RESTIC_REPOSITORY=rest:https://user:password@backup-host:8000/simplycaster
#   RESTIC_REPOSITORY=rclone:pcloud:simplycaster   (needs rclone: see README.md, "Backups")
# RESTIC_REPOSITORY=/backups

# BACKUP_EVERY_SECONDS=86400
# BACKUP_KEEP=--keep-daily 7 --keep-weekly 4 --keep-monthly 6
