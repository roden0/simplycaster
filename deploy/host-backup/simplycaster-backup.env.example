# /etc/simplycaster-backup.env, mode 600, owner root. Read by backup-simplycaster.sh.

# The folder mounted as /data in the SimplyCaster container. On Coolify, its volume:
#   docker volume inspect <volume> --format '{{ .Mountpoint }}'
DATA_DIR=/var/lib/docker/volumes/<volume>/_data

# Any restic repository: /srv/backups/simplycaster, s3:..., b2:..., sftp:..., rest:..., or
# rclone:<remote>:<path> to reach anything rclone supports (pCloud, Drive, OneDrive...).
RESTIC_REPOSITORY=rclone:pcloud:simplycaster
# A file holding the restic password (mode 600). Keep a copy elsewhere: without it nothing can be restored.
RESTIC_PASSWORD_FILE=/root/.simplycaster-restic-password
# Only for rclone: repositories; the rclone configuration that defines the remote.
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# For s3: or b2: repositories, their credentials instead:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# KEEP=--keep-daily 7 --keep-weekly 4 --keep-monthly 6

# Optional: a Telegram message when a backup fails. Files with the bot token and the chat id.
# TELEGRAM_TOKEN_FILE=/root/.telegram-bot-token
# TELEGRAM_CHAT_FILE=/root/.telegram-chat-id
